rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Document IDs end up inside the app's HTML, so IDs that clients choose are
    // restricted to a harmless alphabet.
    function safeId(id) { return id.matches('^[A-Za-z0-9_-]{1,128}$'); }

    // True when user `a` has blocked user `b`. A block shuts off every way `b`
    // can reach `a`: comments, props, follows, follow requests and messages.
    function blocks(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b));
    }
    // Comments can't contain the worst cuss words or slurs. The app's
    // moderation.js filter is stricter (look-alike letters, mild words); this
    // is the backstop for anyone writing to the database directly.
    function cleanText(t) {
      return t is string &&
        !t.lower().matches('(?s).*(fuck|shit|cunt|bitch|nigger|nigga|motherf|faggot|cocksuck|asshole|dickhead|bullshit|dumbass|jackass|whore|slut|bastard|pussy).*') &&
        !t.lower().matches('(?s)(.*[^a-z0-9])?(ass|dick|cock|tits|wtf|stfu|kys|retard|retarded)([^a-z0-9].*)?');
    }

    // Neither person in a direct-message thread has blocked the other.
    function dmOpen(convId) {
      let p = get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      return !blocks(p[0], p[1]) && !blocks(p[1], p[0]);
    }

    // True unless the club is a private, member-listed club the caller isn't in.
    function canReadClub(clubId) {
      let path = /databases/$(database)/documents/clubs/$(clubId);
      return !exists(path) || get(path).data.get('isPrivate', false) != true ||
        !('members' in get(path).data) || request.auth.uid in get(path).data.members;
    }

    // ── USER PROFILES ──────────────────────────────────────────────────
    // Public read for all authenticated users, self-write only
    match /users/{userId} {
      allow read: if request.auth != null;
      // Self-write only — but never the `sub` (subscription) field. That is
      // written exclusively by the Stripe webhook via the Admin SDK (which
      // bypasses these rules). If owners could write it they could grant
      // themselves a paid tier, or copy another user's Stripe customer /
      // subscription ID into their own doc and then cancel that person's plan
      // or open their billing portal through /api/*.
      allow create: if request.auth != null && request.auth.uid == userId
        && !('sub' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('sub', null) == resource.data.get('sub', null);
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Follow REQUESTS to a private account. The requester creates/cancels the
      // doc keyed by their own uid; the profile owner reads and clears them.
      match /followRequests/{requesterId} {
        allow read: if request.auth != null &&
          (request.auth.uid == userId || request.auth.uid == requesterId);
        allow create: if request.auth != null && request.auth.uid == requesterId
          && request.resource.data.uid == request.auth.uid && !blocks(userId, requesterId);
        allow delete: if request.auth != null &&
          (request.auth.uid == userId || request.auth.uid == requesterId);
      }

      // Follower edges: anyone can read (for counts/lists); you may only create/delete
      // the edge keyed by your OWN uid (i.e. you follow/unfollow as yourself).
      match /followers/{followerId} {
        allow read: if request.auth != null;
        // You may write the edge for yourself (you follow someone), OR the profile owner
        // may write edges under their own profile (approving a private follow request).
        allow create, update: if request.auth != null &&
          ((request.auth.uid == followerId && !blocks(userId, followerId)) || request.auth.uid == userId);
        allow delete: if request.auth != null &&
          (request.auth.uid == followerId || request.auth.uid == userId);
      }

      // Feed PROPS (likes) on this user's activities — anyone reads; you may only
      // create/delete a prop attributed to your own uid.
      match /props/{propId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.reactor == request.auth.uid && safeId(propId)
          && !blocks(userId, request.auth.uid);
        // The reactor can take their kudos back; the profile owner can clear
        // them (needed for account deletion).
        allow delete: if request.auth != null &&
          (resource.data.reactor == request.auth.uid || request.auth.uid == userId);
      }

      // Feed COMMENTS on this user's activities — anyone reads; you may only
      // create/delete a comment attributed to your own uid.
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.from == request.auth.uid && safeId(commentId)
          && !blocks(userId, request.auth.uid) && cleanText(request.resource.data.text);
        // The commenter can delete their comment; the post's author can remove
        // any comment left on their own activity.
        allow delete: if request.auth != null &&
          (resource.data.from == request.auth.uid || request.auth.uid == userId);
      }

      // People this user has blocked, keyed by the blocked uid. Only the owner
      // lists them; the blocked person may look up their own entry.
      match /blocks/{blockedId} {
        allow get: if request.auth != null &&
          (request.auth.uid == userId || request.auth.uid == blockedId);
        allow list: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId &&
          blockedId != userId && safeId(blockedId) &&
          request.resource.data.keys().hasOnly(['blocked', 'name', 'at']) &&
          request.resource.data.blocked == blockedId &&
          (!('name' in request.resource.data) ||
           (request.resource.data.name is string && request.resource.data.name.size() <= 80));
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // "Who has blocked me" (collection-group query on blocks where blocked ==
    // me) so the app can keep those people out of my feed and search too.
    match /{path=**}/blocks/{blockedId} {
      allow read: if request.auth != null && resource.data.blocked == request.auth.uid;
    }

    // ── REPORTS ────────────────────────────────────────────────────────
    // Anyone signed in can file a report as themselves. Nobody can read,
    // change or delete one from the app: they are reviewed in the Firebase
    // console (or by the email /api/notify sends).
    match /reports/{reportId} {
      allow create: if request.auth != null && safeId(reportId) &&
        request.resource.data.keys().hasOnly(['reporter','reporterName','target','targetName','kind','refPath','text','reason','details','at','status']) &&
        request.resource.data.reporter == request.auth.uid &&
        request.resource.data.target is string && safeId(request.resource.data.target) &&
        request.resource.data.target != request.auth.uid &&
        request.resource.data.kind in ['user', 'comment', 'message', 'post'] &&
        request.resource.data.reason in ['harassment', 'spam', 'inappropriate', 'impersonation', 'other'] &&
        request.resource.data.text is string && request.resource.data.text.size() <= 1000 &&
        request.resource.data.details is string && request.resource.data.details.size() <= 1000 &&
        request.resource.data.refPath is string && request.resource.data.refPath.size() <= 300 &&
        request.resource.data.status == 'open';
      allow read, update, delete: if false;
    }

    // ── USER STATE ─────────────────────────────────────────────────────
    // Private — only the owning user can read/write
    match /userState/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── DIRECT MESSAGE CONVERSATIONS ───────────────────────────────────
    // Conversation ID is deterministic: sorted(uid1, uid2).join('__dm__')
    // Any authenticated user can create/read/update conversations they participate in.
    // We allow any auth'd user to create so either side can initiate.
    match /conversations/{convId} {
      // `resource == null` lets a participant-to-be check whether the thread
      // exists yet. Without it, a get() on a not-yet-created conversation is a
      // rules evaluation error (null resource) and the first DM between two
      // users could never be started.
      allow get: if request.auth != null &&
        (resource == null || request.auth.uid in resource.data.participants);
      allow list: if request.auth != null &&
        request.auth.uid in resource.data.participants;
      // Exactly two participants, caller is one of them, and the doc ID is the
      // deterministic pair ID — so nobody can squat on someone else's thread.
      allow create: if request.auth != null &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants &&
        (convId == request.resource.data.participants[0] + '__dm__' + request.resource.data.participants[1] ||
         convId == request.resource.data.participants[1] + '__dm__' + request.resource.data.participants[0]);
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants.toSet() == resource.data.participants.toSet();

      match /messages/{msgId} {
        // Read: must be a participant of the parent conversation
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        // Create: sender must match the from field AND be a participant —
        // otherwise any signed-in user could inject messages into any thread.
        allow create: if request.auth != null &&
          request.resource.data.from == request.auth.uid && safeId(msgId) &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants &&
          dmOpen(convId);
        // Delete: only the original sender can delete their own message
        allow delete: if request.auth != null &&
          resource.data.from == request.auth.uid;
      }
    }

    // ── STUDY CLUBS ────────────────────────────────────────────────────
    // Public clubs are readable by all authenticated users.
    // Any authenticated user can join (write to their own member doc).
    match /clubs/{clubId} {
      // Cohorts and public clubs are readable by any signed-in user. A club
      // marked isPrivate with a `members` uid list (user-created clubs) is
      // readable only by the people on that list.
      allow get: if request.auth != null &&
        (resource == null || resource.data.get('isPrivate', false) != true ||
         !('members' in resource.data) || request.auth.uid in resource.data.members);
      allow list: if request.auth != null &&
        (resource.data.get('isPrivate', false) != true ||
         request.auth.uid in resource.data.members);
      // Create/update club metadata — any signed-in user (joining a firm cohort
      // writes this doc before their own members/ record exists, so we can't
      // require membership here without breaking that flow). To still block
      // arbitrary field injection, only these known fields may be written.
      allow create: if request.auth != null && safeId(clubId) &&
        request.resource.data.keys().hasOnly([
          'name','desc','icon','isPrivate','isPublic','isCohort','firmCode',
          'members','lastMessage','lastFrom','lastAt','memberCount',
          'monthlyGoalHrs','monthlyGoalSetBy','monthlyGoalAt','created'
        ]) &&
        (!('members' in request.resource.data) || request.auth.uid in request.resource.data.members);
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','desc','icon','isPrivate','isPublic','isCohort','firmCode',
          'members','lastMessage','lastFrom','lastAt','memberCount',
          'monthlyGoalHrs','monthlyGoalSetBy','monthlyGoalAt','created'
        ]) &&
        // The member list (and the private flag that guards it) can only be
        // changed by someone already on the list — otherwise anyone could add
        // themselves to a private club and read its chat.
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['members','isPrivate']) ||
         !('members' in resource.data) || request.auth.uid in resource.data.members);

      match /messages/{msgId} {
        allow read: if request.auth != null && canReadClub(clubId);
        // Only the sender can create a message with their own UID
        allow create: if request.auth != null &&
          request.resource.data.from == request.auth.uid && safeId(msgId) && canReadClub(clubId);
        // Only the original sender can delete their own message
        allow delete: if request.auth != null &&
          resource.data.from == request.auth.uid;
      }

      match /members/{userId} {
        allow read: if request.auth != null;
        // Users can only write their own membership record
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Live "studying now" presence — anyone reads; you write only your own presence doc.
      match /presence/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      // Club-only study rooms: same shape as /rooms, visible to whoever can read the club.
      match /rooms/{roomId} {
        allow read: if request.auth != null && canReadClub(clubId);
        allow create: if roomCreate(roomId) && canReadClub(clubId);
        allow update: if roomUpdate() && canReadClub(clubId);
        allow delete: if roomDelete();
        match /members/{uid} {
          allow read: if request.auth != null && canReadClub(clubId);
          allow create, update: if roomMemberWrite(uid) && canReadClub(clubId);
          allow delete: if request.auth != null && request.auth.uid == uid;
        }
      }
    }

    // ── NOTIFICATION PROFILE ───────────────────────────────────────────
    // Private: what the reminder job needs to know about a user (time zone,
    // streak, exam dates, preferences) and their devices' push tokens.
    // notifyMeta/{uid} (send counters) has no rule on purpose: server only.
    match /notify/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['tz','name','streak','lastStudyDate','week','today','exams','scoreDue','prefs','watch','tokens','updatedAt']) &&
        (!('watch' in request.resource.data) || request.resource.data.watch.size() <= 20) &&
        (!('tokens' in request.resource.data) || request.resource.data.tokens.size() <= 10);
    }

    // ── STUDY ROOMS ────────────────────────────────────────────────────
    // A room's settings belong to its host. Everyone else may only refresh the
    // "still alive" stamp and head count, and keep their own row in members/.
    function roomCreate(roomId) {
      return request.auth != null && safeId(roomId) &&
        request.resource.data.hostUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['name','hostUid','hostName','focusMin','breakMin','timerStart','createdAt','lastActive','count']) &&
        request.resource.data.name is string && request.resource.data.name.size() <= 60 &&
        request.resource.data.focusMin is int && request.resource.data.focusMin >= 0 && request.resource.data.focusMin <= 180 &&
        request.resource.data.breakMin is int && request.resource.data.breakMin >= 0 && request.resource.data.breakMin <= 60;
    }
    function roomUpdate() {
      return request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActive','count']) &&
        request.resource.data.lastActive is number && request.resource.data.count is int &&
        request.resource.data.count >= 0 && request.resource.data.count <= 500;
    }
    // The host closes the room; anyone may sweep one that has been dead for hours.
    function roomDelete() {
      return request.auth != null &&
        (resource.data.hostUid == request.auth.uid ||
         resource.data.lastActive < request.time.toMillis() - 6 * 60 * 60 * 1000);
    }
    function roomMemberWrite(uid) {
      return request.auth != null && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.keys().hasOnly(['uid','name','initials','color','section','material','joinedAt','lastBeat','status','elapsed']);
    }
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if roomCreate(roomId);
      allow update: if roomUpdate();
      allow delete: if roomDelete();
      match /members/{uid} {
        allow read: if request.auth != null;
        allow create, update: if roomMemberWrite(uid);
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ── QUESTION BANK ──────────────────────────────────────────────────
    // Shared, read-only bank of pre-generated practice questions. Populated
    // once by the server-side admin job (firebase-admin bypasses these rules),
    // then served to every user as cheap database reads.
    match /questionBank/{section} {
      allow read: if request.auth != null;
      allow write: if false;
      match /topics/{topicId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

  }
}
